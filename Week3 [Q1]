import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int[] price=new int[5];
        int tot=0;

        for (int i=0;i<5;i++) {
            price[i]=sc.nextInt();
        }
        for (int i=0;i<5;i++) {
            tot+= price[i];
        }
        System.out.println("Total bill: "+tot);
        if (tot>5000) {
            System.out.println("Discount Applicable");
        } else {
            System.out.println("No Discount");
        }
        sc.close();
    }
}